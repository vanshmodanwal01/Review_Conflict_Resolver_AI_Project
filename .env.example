# Review Conflict Resolver - Environment Configuration

# Application
ENVIRONMENT=development
DEBUG=True
APP_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Database
# For PostgreSQL with pgvector (recommended for production & full vector indexing):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/review_conflict_resolver
# Fallback local SQLite (supported for rapid development and testing without docker):
# DATABASE_URL=sqlite:///./review_conflict_resolver.db

# Vector Indexing
VECTOR_DIMENSION=384
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Background Processing (Redis & Celery)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
ASYNC_PROCESSING_MODE=in_process  # Options: 'celery' or 'in_process' (fallback when Redis is not running)

# External LLM Providers
# Primary Default Provider:
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Fallback / Alternative Provider:
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

DEFAULT_LLM_PROVIDER=gemini  # 'gemini' or 'openai'
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=3

# Review Data Acquisition / Rate Limiting
RATE_LIMIT_PER_MINUTE=30
ALLOW_SCRAPING=False  # Keep False by default to strictly respect platform Terms of Service
MOCK_DATA_FALLBACK=True  # Enables authentic pre-curated laptop conflict datasets when external APIs are rate limited
